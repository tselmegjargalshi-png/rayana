# --- Rayana environment variables (all optional in demo mode) ---
# Secret used to sign session cookies. REQUIRED in production (min 32 chars).
SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the local demo database + uploads live (default ./.data, /tmp/rayana on Vercel)
DATA_DIR=
# Set to "false" to hide the demo-mode banner / demo logins (production)
NEXT_PUBLIC_DEMO_MODE=true
# Public demo deployments: set a private admin password (hides the default demo admin login)
DEMO_ADMIN_PASSWORD=
# Initial admin created when DEMO_MODE=false and the DB is empty
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Supabase (optional). When both are set, state persists in Supabase instead of local files.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# RESERVED, not implemented yet: real payment gateway credentials. ALL payments are simulated demo flows today.
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
SOCIALPAY_TERMINAL=
SOCIALPAY_KEY=
